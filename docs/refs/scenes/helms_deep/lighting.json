      "reason": "Reduce broad key wash while preserving local contrast; Moria shaft and storm key use stronger directional separation."
    },
    {
      "field": "hemiIntensity",
      "current": 0.6,
      "recommended": 0.7,
      "reason": "Balance readable shadow silhouettes with directional depth; avoid uniformly filled interiors."
    },
    {
      "field": "fog.density",
      "current": 0.0165,
      "recommended": 0.01,
      "reason": "Extend silhouette visibility across the combat and set-piece routes; horizon colour remains matched."
    },
    {
      "field": "bloom",
      "current": 0.3,
      "recommended": 0.18,
      "reason": "Restrict bloom to flames and hot glints; prevent haze from obscuring aiming targets."
    },
