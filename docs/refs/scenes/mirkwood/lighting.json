    {
      "field": "sunIntensity",
      "current": 3.4,
      "recommended": 2.8,
      "reason": "Reduce broad key wash while preserving local contrast; Moria shaft and storm key use stronger directional separation."
    },
    {
      "field": "hemiIntensity",
      "current": 1.1,
      "recommended": 0.55,
      "reason": "Balance readable shadow silhouettes with directional depth; avoid uniformly filled interiors."
    },
    {
      "field": "envIntensity",
      "current": 1,
      "recommended": 0.65,
      "reason": "Keep PBR reflections without making all occluded surfaces self-lit."
    },
    {
      "field": "fog.density",
      "current": 0.03,
      "recommended": 0.018,
      "reason": "Extend silhouette visibility across the combat and set-piece routes; horizon colour remains matched."
    },
    {
      "field": "exposure",
      "current": 1.3,
      "recommended": 1.15,
      "reason": "Protect shafts and marble highlights while retaining the dark setting."
    },
    {
      "field": "bloom",
      "current": 0.32,
      "recommended": 0.18,
      "reason": "Restrict bloom to flames and hot glints; prevent haze from obscuring aiming targets."
    },
    {
      "field": "grade.vignette",
      "current": 0.55,
      "recommended": 0.32,
      "reason": "Lower edge darkening and oversaturation to preserve peripheral enemy and traversal readability."
    }
